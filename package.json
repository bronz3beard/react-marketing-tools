{
  "name": "react-marketing-tools",
  "type": "module",
  "version": "1.0.0-beta.4",
  "description": "One track() call for Google Tag Manager, Google Analytics 4 and the Meta Pixel, with Consent Mode v2, UTM attribution and personal-data redaction built in. React bindings included.",
  "license": "MIT",
  "author": "bronz3beard <exempli.gratia.webdesign@gmail.com> (https://www.heyrory.com/)",
  "homepage": "https://www.heyrory.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bronz3beard/react-marketing-tools.git"
  },
  "bugs": {
    "url": "https://github.com/bronz3beard/react-marketing-tools/issues"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "analytics",
    "marketing",
    "google-tag-manager",
    "gtm",
    "datalayer",
    "google-analytics",
    "ga4",
    "gtag",
    "meta-pixel",
    "facebook-pixel",
    "consent-mode",
    "gdpr",
    "utm",
    "attribution",
    "server-side-tagging"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./fingerprintjs": {
      "types": "./dist/fingerprintjs.d.ts",
      "default": "./dist/fingerprintjs.js"
    },
    "./web-vitals": {
      "types": "./dist/webVitals.d.ts",
      "default": "./dist/webVitals.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "tag": "next"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:watch": "vite build --watch",
    "check:links": "node scripts/check-links.mjs",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "check:size": "node scripts/check-size.mjs",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "mock:publish": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm run check:size",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@fingerprintjs/fingerprintjs": "^5.0.0",
    "react": ">=18.0.0",
    "web-vitals": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@fingerprintjs/fingerprintjs": {
      "optional": true
    },
    "web-vitals": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "web-vitals": "^6.2.2"
  }
}
